flowchart TD
    subgraph CLIENT_CREATION["Frontend - Creation Mission"]
        CA1["pages/entreprise/create-mission.vue"]
        CA2["CompanyCgvSignatureFlow.vue"]
        CA3["Supabase RPC: create_mission_v2"]
    end

    subgraph CLIENT_CANDIDATURE["Frontend - Candidature"]
        CB1["pages/prestataire/mission/id.vue"]
        CB2["PostulerDrawer.vue - 5 etapes"]
        CB3["Supabase INSERT: missions.profile_missions"]
    end

    subgraph CLIENT_DEVIS["Frontend - Devis Payee"]
        CD1["pages/entreprise/devis/pmId.vue"]
        CD2["ContractRecap + DevisSignature"]
        CD3["POST /api/contract/company/verify-otp"]
    end

    subgraph CLIENT_CONTRAT["Frontend - Convention Benevole"]
        CE1["pages/prestataire/contrat/id.vue"]
        CE2["pages/entreprise/contrat/id.vue"]
        CE3["POST /api/contract/provider/verify-otp"]
        CE4["POST /api/contract/company/verify-otp"]
    end

    subgraph CLIENT_RAPPORT["Frontend - Rapport"]
        CF1["MissionFinishedPopup.vue"]
        CF2["POST /api/missions/provider-submit-report"]
        CF3["POST /api/missions/validate-report"]
    end

    subgraph CLIENT_PAIEMENT["Frontend - Paiement Final"]
        CG1["SlideButton - company-direct-pay"]
        CG2["POST /api/missions/company-direct-pay"]
    end

    subgraph CLIENT_NOTE["Frontend - Notation"]
        CH1["RatingProviderDrawer.vue"]
        CH2["RatingCompanyDrawer.vue"]
        CH3["RPC: submit_provider_rating"]
        CH4["RPC: submit_company_rating"]
    end

    subgraph SERVER_API["Server API - Nitro"]
        SA1["server/api/contract/company/verify-otp.js"]
        SA2["server/api/contract/provider/verify-otp.js"]
        SA3["server/api/stripe/create-payment-intent.js"]
        SA4["server/api/stripe/webhook.js"]
        SA5["server/api/missions/company-direct-pay.js"]
        SA6["server/api/missions/provider-submit-report.js"]
        SA7["server/api/missions/validate-report.js"]
        SA8["server/api/push/send.js"]
    end

    subgraph STRIPE["Stripe Connect"]
        ST1["paymentIntent.create"]
        ST2["application_fee_amount - commission"]
        ST3["transfer_data.destination - prestataire"]
        ST4["Webhook: payment_intent.succeeded"]
    end

    subgraph DATABASE["Supabase / PostgreSQL"]
        DB1["missions.missions - status: open/assigned/completed/canceled"]
        DB2["missions.profile_missions - state: postule/accepted/assigned/completed"]
        DB3["missions.contrats - provider_signed_at, company_signed_at"]
        DB4["missions.devis - company_signed_at, amount_ht"]
        DB5["missions.payment_flows - initial_status, final_status"]
        DB6["missions.payment_events - audit trail"]
        DB7["missions.disputes - status, auto_release_at"]
        DB8["public.ratings - provider_rating, company_rating"]
    end

    subgraph REALTIME["Supabase Realtime"]
        RT1["Broadcast: provider_signed"]
        RT2["Broadcast: mission_canceled"]
        RT3["Broadcast: report_submitted"]
    end

    CA1 --> CA2 --> CA3
    CA3 --> DB1
    CA3 --> SA8

    CB1 --> CB2 --> CB3
    CB3 --> DB2

    CD1 --> CD2 --> CD3
    CD3 --> SA1
    SA1 -->|"OTP OK"| SA3
    SA3 --> ST1
    ST1 --> ST2
    ST1 --> ST3

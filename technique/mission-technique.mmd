    SA1 -->|"Update"| DB4
    SA1 -->|"Create"| DB5

    CE1 --> CE3 --> SA2
    SA2 -->|"Update"| DB3
    SA2 -->|"Update"| DB2
    SA2 --> RT1
    CE2 --> CE4 --> SA1
    SA1 -->|"Update"| DB3

    CF1 --> CF2 --> SA6
